}

QScrollBar:vertical {
    background: transparent; /* set track background transparent */
    width: 8px; /* scrollbar width, adjust as needed */
    margin: 0px; /* remove gap between scrollbar and handle */
}

QScrollBar::handle:vertical {
    background: rgb(173,170,169); /* handle color */
    min-height: 10px; /* minimum handle height, adjust as needed */
    border-radius: 4px; /* handle corner radius, adjusted to form an ellipse */
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px; /* remove up/down buttons */
    border: none; /* remove border */
    background: transparent; /* transparent background */
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none; /* transparent background for page scroll area */
}


