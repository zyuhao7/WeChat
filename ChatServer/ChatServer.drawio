        <mxCell id="cs-e1" value="POST /user_login&lt;br&gt;email + XOR 混淆密码" style="endArrow=classic;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" edge="1" parent="1" source="cs-client" target="cs-gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cs-e2" value="CheckPwd(email, pwd)" style="endArrow=classic;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" edge="1" parent="1" source="cs-gate" target="cs-mysql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cs-e3" value="gRPC GetChatServer(uid)" style="endArrow=classic;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" edge="1" parent="1" source="cs-gate" target="cs-status">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cs-e4" value="HGET logincount&lt;br&gt;SETEX utoken_{uid} 600s" style="endArrow=classic;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" edge="1" parent="1" source="cs-status" target="cs-redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cs-e5" value="host + port + token" style="endArrow=classic;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" edge="1" parent="1" source="cs-status" target="cs-gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cs-e6" value="host + port + token" style="endArrow=classic;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" edge="1" parent="1" source="cs-gate" target="cs-client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
