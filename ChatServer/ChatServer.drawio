          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cs-e8" value="GET utoken_{uid}&lt;br&gt;校验 token" style="endArrow=classic;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" edge="1" parent="1" source="cs-chat" target="cs-redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cs-e9" value="LoadUserInfoByUid&lt;br&gt;好友列表" style="endArrow=classic;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" edge="1" parent="1" source="cs-chat" target="cs-mysql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cs-e10" value="SET uip_{uid} · acquireLock&lt;br&gt;HINCR logincount" style="endArrow=classic;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" edge="1" parent="1" source="cs-chat" target="cs-redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cs-e11" value="MSG_CHAT_LOGIN_RSP (1006)" style="endArrow=classic;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" edge="1" parent="1" source="cs-chat" target="cs-client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cs-note1" value="重复登录：先给本服旧连接下发 ID_NOTIFY_OFF_LINE_REQ 再接管；跨服踢人尚未实现。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="700" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cs-note2" value="Redis 键：utoken_{uid}、uip_{uid}、logincount(HASH)、lock_{uid}" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="800" y="620" width="420" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cs-note3" value="GateServer 只在登录时查 MySQL；ChatServer 校验 token 直接读 Redis，不经过 StatusServer。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSize=14;" vertex="1" parent="1">
