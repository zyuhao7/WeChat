# Point clangd at the CMake-generated compilation database so IDE diagnostics
# resolve the real include paths (Boost, gRPC, jsoncpp, hiredis, generated proto).
CompileFlags:
  CompilationDatabase: build

# Many headers are pulled in transitively (const.h, AsioIOServicePool.h, ...).
# Turn off the "included header is not used directly" hint so those includes
# are not flagged.
Diagnostics:
  UnusedIncludes: None
