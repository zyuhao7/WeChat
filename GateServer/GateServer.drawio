        <mxCell id="gt-note1" value="路由表：GET /get_test；POST /get_verify_code、/user_register、/reset_pwd、/user_login。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="gt-note2" value="注册/重置：LogicSystem 先 GET code_{email} 与请求里的验证码比对，成功后 DEL 消费；验证码本身由 VerifyServer 生成并写 Redis。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="670" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="gt-note3" value="登录：密码是 XOR 混淆值，CheckPwd 通过后 gRPC 向 StatusServer 要 host/port/token，把 chat server 地址回给客户端。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="gt-note4" value="HttpConnection 的 deadline_timer 控制读写超时，响应写完后关闭发送端并结束连接。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSize=14;" vertex="1" parent="1">
