<mxfile host="Electron" modified="2026-10-25T08:35:00.000Z" agent="Mozilla/5.0 (X11; Linux x86_64) drawio" version="24.7.17" type="device">
  <diagram name="邮箱验证码" id="verify-code-flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="20000" pageHeight="20000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="vs-gate" value="GateServer" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="vs-verify" value="VerifyServer&lt;br&gt;(Node.js)" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="410" y="220" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="vs-redis" value="Redis" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="850" y="130" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="vs-mail" value="SMTP → 用户邮箱" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="850" y="380" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="vs-e1" value="gRPC GetVerifyCode(email)" style="endArrow=classic;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" edge="1" parent="1" source="vs-gate" target="vs-verify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vs-e2" value="① SET verify_cooldown_{email} 1 EX 60 NX&lt;br&gt;已存在 → TooFrequent" style="endArrow=classic;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" edge="1" parent="1" source="vs-verify" target="vs-redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vs-e3" value="② GET code_{email}&lt;br&gt;重发沿用仍有效的旧码" style="endArrow=classic;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" edge="1" parent="1" source="vs-redis" target="vs-verify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vs-e4" value="③ SET code_{email} &lt;6 位随机码&gt; EX 600" style="endArrow=classic;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" edge="1" parent="1" source="vs-verify" target="vs-redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vs-e5" value="④ 发送验证码邮件" style="endArrow=classic;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" edge="1" parent="1" source="vs-verify" target="vs-mail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vs-e6" value="GetVerifyRsp(error)" style="endArrow=classic;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontSize=14;" edge="1" parent="1" source="vs-verify" target="vs-gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vs-note1" value="邮箱格式先校验；cooldown 用 SET NX 抢占，避免并发重复发信。发送或写 Redis 失败会 DEL cooldown，允许用户立刻重试。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="800" height="50" as="geometry" />
        </mxCell>
        <mxCell id="vs-note2" value="验证码只在 Redis 里（code_ 前缀，TTL 600s），VerifyServer 不把码返回给网关；GateServer 在注册/重置时自己 GET code_{email} 比对，通过后 DEL 消费。" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Architects Daughter;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="980" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
